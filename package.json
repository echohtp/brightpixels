{
  "name": "brightpixels",
  "version": "1.1.0",
  "description": "A tiny dependency-free library for HDR text, image highlights, and native shapes.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "browser": "./index.js",
  "types": "./index.d.ts",
  "unpkg": "./index.js",
  "jsdelivr": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js",
      "default": "./react.js"
    },
    "./particles": {
      "types": "./particles.d.ts",
      "import": "./particles.js",
      "default": "./particles.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "react.js",
    "react.d.ts",
    "README.md",
    "LICENSE.txt",
    "particles.js",
    "particles.d.ts",
    "particles-shader.js"
  ],
  "sideEffects": [
    "./index.js",
    "./react.js"
  ],
  "scripts": {
    "test": "npm run check:particles && node --test test/*.test.mjs",
    "prepublishOnly": "npm test && npm run test:types",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:browser": "playwright test",
    "build:particles": "node scripts/build-particles.mjs",
    "check:particles": "node scripts/build-particles.mjs --check"
  },
  "keywords": [
    "hdr",
    "text",
    "image",
    "media",
    "react",
    "typography",
    "web-component",
    "webgpu",
    "custom-element",
    "brighter-than-white"
  ],
  "homepage": "https://echohtp.github.io/brightpixels/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echohtp/brightpixels.git"
  },
  "bugs": {
    "url": "https://github.com/echohtp/brightpixels/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typegpu": "0.12.4",
    "typescript": "^7.0.2"
  }
}
