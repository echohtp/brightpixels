{
  "name": "brightpixels",
  "version": "1.4.0",
  "description": "HDR text, images, shapes, interactive surfaces and particles, with optional React components.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "browser": "./index.js",
  "types": "./index.d.ts",
  "unpkg": "./index.js",
  "jsdelivr": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js",
      "default": "./react.js"
    },
    "./particles": {
      "types": "./particles.d.ts",
      "import": "./particles.js",
      "default": "./particles.js"
    },
    "./confetti": {
      "types": "./confetti.d.ts",
      "import": "./confetti.js",
      "default": "./confetti.js"
    },
    "./react-confetti": {
      "types": "./react-confetti.d.ts",
      "import": "./react-confetti.js",
      "default": "./react-confetti.js"
    },
    "./react-surface": {
      "types": "./react-surface.d.ts",
      "import": "./react-surface.js",
      "default": "./react-surface.js"
    },
    "./interactions": {
      "types": "./interactions.d.ts",
      "import": "./interactions.js",
      "default": "./interactions.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "react.js",
    "react.d.ts",
    "README.md",
    "LICENSE.txt",
    "particles.js",
    "particles.d.ts",
    "particles-shader.js",
    "confetti.js",
    "confetti.d.ts",
    "react-confetti.js",
    "react-confetti.d.ts",
    "react-surface.js",
    "react-surface.d.ts",
    "interactions.js",
    "interactions.d.ts"
  ],
  "sideEffects": [
    "./index.js",
    "./react.js"
  ],
  "scripts": {
    "test": "npm run check:particles && node scripts/build-confetti-demo.mjs --check && node scripts/build-surfaces-demo.mjs --check && node scripts/build-actions-demo.mjs --check && node --test test/*.test.mjs",
    "prepublishOnly": "npm test && npm run test:types",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:browser": "node scripts/build-confetti-demo.mjs --test && node scripts/build-surfaces-demo.mjs --test && playwright test",
    "build:confetti-demo": "node scripts/build-confetti-demo.mjs",
    "build:particles": "node scripts/build-particles.mjs",
    "check:particles": "node scripts/build-particles.mjs --check",
    "build:surfaces-demo": "node scripts/build-surfaces-demo.mjs",
    "build:actions-demo": "node scripts/build-actions-demo.mjs"
  },
  "keywords": [
    "hdr",
    "text",
    "image",
    "media",
    "react",
    "typography",
    "web-component",
    "webgpu",
    "custom-element",
    "brighter-than-white"
  ],
  "homepage": "https://echohtp.github.io/brightpixels/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echohtp/brightpixels.git"
  },
  "bugs": {
    "url": "https://github.com/echohtp/brightpixels/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typegpu": "0.12.4",
    "typescript": "^7.0.2"
  }
}
